<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/a1_textView_01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pierwsza aktywność"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        android:textSize="30sp"/>

    <Button
        android:id="@+id/a_1btn_01"
        android:text="Otwórz drugą aktywność"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/a1_textView_01"
        android:layout_marginTop="30dp"
        android:textSize="26dp"/>

    <EditText
        android:id="@+id/a1_editText_01"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/a_1btn_01"
        android:layout_margin="30dp"
        android:textSize="30sp"/>

    <Button
        android:id="@+id/a_1btn_02"
        android:text="Otwórz drugą aktywność i prześlij dane"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/a1_editText_01"
        android:layout_marginTop="30dp"
        android:textSize="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>